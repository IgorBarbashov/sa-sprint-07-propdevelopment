        </mxCell>
        <mxCell id="Y6FMSrg1lnaqVBLyCyk1-10" value="&lt;div&gt;&lt;ul&gt;&lt;li&gt;Active Directory (данные об аутентификации клиентов)&lt;/li&gt;&lt;li&gt;Данные систем логирования и мониторинга&lt;/li&gt;&lt;li&gt;Информация о безопасности IT-систем&lt;/li&gt;&lt;li&gt;Данные о ключах шифрования&lt;/li&gt;&lt;li&gt;Данные о внутренних уязвимостях, инцидентах безопасности&lt;/li&gt;&lt;li&gt;Бухгалтерские и финансовые данные компании&lt;/li&gt;&lt;li&gt;Резервное копирование данных&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;" parent="1" vertex="1">
