        <mxCell id="Y6FMSrg1lnaqVBLyCyk1-30" value="&lt;div&gt;&lt;ul&gt;&lt;li&gt;утечка данных&lt;/li&gt;&lt;li&gt;потеря данных&lt;/li&gt;&lt;li&gt;искажение данных&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;" parent="1" vertex="1">
          <mxGeometry x="960" y="400" width="200" height="100" as="geometry" />
