          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Y6FMSrg1lnaqVBLyCyk1-9" value="&lt;div&gt;&lt;ul&gt;&lt;li&gt;Клиенты (ФИО, телефон, email)&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Собственники (ФИО, телефон, email, расширенная форма)&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Онлайн-сделка - платежи&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Онлайн-сделка - юридические документы&lt;/span&gt;&lt;/li&gt;&lt;li&gt;Бронирование недвижимости - расширенная форма о клиентах&lt;/li&gt;&lt;li&gt;Бронирование недвижимости&lt;/li&gt;&lt;li&gt;Результаты осмотра объекта недвижимости (он-лайн и офф-лайн)&lt;/li&gt;&lt;li&gt;Оплата услуг ЖКХ&lt;/li&gt;&lt;li&gt;Информация об умных устройствах (автоматика внутри, запирающее устройство)&lt;/li&gt;&lt;li&gt;Коммерческие тайны, планы развития и интеграции с партнёрами&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;" parent="1" vertex="1">
          <mxGeometry x="440" y="640" width="440" height="180" as="geometry" />
